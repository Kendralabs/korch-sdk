# Korchestrator SDK — local environment (repo root)
#
# Copy this file to `.env` (already gitignored) and fill in real values. Every example under
# `examples/` runs with no configuration at all (offline, deterministic MockLM/OfflineGateway) —
# these variables only switch examples/08_support_escalation_swarm.py (and anything you build the
# same way) over to real OpenAI models.

# --- OpenAI ---------------------------------------------------------------------------------
# Required to run examples against a real model instead of the offline fallback.
OPENAI_API_KEY=

# Optional: point at any OpenAI-compatible endpoint (Azure OpenAI, a self-hosted proxy, etc.).
# Defaults to https://api.openai.com/v1 when unset.
OPENAI_BASE_URL=

# --- Per-agent model overrides (examples/08_support_escalation_swarm.py) --------------------
# Each agent defaults to a sensible model (triage/researcher/reviewer: gpt-4o-mini, resolver:
# gpt-4o). Override any of them independently to try different models per agent.
# TRIAGE_MODEL=gpt-4o-mini
# RESEARCHER_MODEL=gpt-4o-mini
# RESOLVER_MODEL=gpt-4o
# REVIEWER_MODEL=gpt-4o-mini
