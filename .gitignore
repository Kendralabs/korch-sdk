# --- Claude Code --------------------------------------------------------------
# .claude/ IS tracked — it is project configuration shared by the whole team.
# Only personal, machine-local overrides are ignored.
.claude/settings.json

# --- Python build / packaging artifacts ---------------------------------------
dist/
build/
*.egg-info/
*.egg
__pycache__/
*.py[cod]
*.so

# --- Virtual environments -----------------------------------------------------
.venv/
venv/
env/

# --- Tooling caches -----------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- Docs site ----------------------------------------------------------------
site/

# --- Secrets and local data (never tracked) -----------------------------------
.env
.env.*
!.env.example
*.db
*.sqlite3
