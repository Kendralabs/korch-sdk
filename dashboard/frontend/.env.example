# Copy to .env in this directory for local `npm run dev`. Vite only exposes vars prefixed VITE_.
# Left unset (or empty) in the production Docker image, where nginx reverse-proxies /api/* to the
# backend container on the same origin — see dashboard/frontend/Dockerfile and nginx.conf.
VITE_API_BASE=http://localhost:8000

# Bedrock model id without the "bedrock/" prefix (region-specific — see BEDROCK_MODEL_ID in
# dashboard/backend/.env.example for the same value on the backend side).
VITE_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
