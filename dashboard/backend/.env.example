# Korchestrator Dashboard — Backend Environment (example)
#
# Copy to `.env` in this directory and fill in real values. `.env` is gitignored
# (see repository root .gitignore) and must never be committed.

# ─── Bedrock (Claude Sonnet 4 via Bearer Token) ───────────────
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token
AWS_DEFAULT_REGION=us-east-1

# Model ID resolved when an agent/scenario routes to "bedrock" without a fully
# qualified model ID. Cross-region inference profile for Claude Sonnet 4.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# ─── Optional: OpenAI / Anthropic (direct, non-Bedrock) ───────
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
