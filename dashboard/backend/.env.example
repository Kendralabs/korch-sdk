# Korchestrator Dashboard — Backend Environment (example)
#
# Copy to `.env` in this directory and fill in real values. `.env` is gitignored
# (see repository root .gitignore) and must never be committed.

# ─── Bedrock (Claude Sonnet 4 via Bearer Token) ───────────────
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token
AWS_DEFAULT_REGION=us-east-1

# Model ID resolved when an agent/scenario routes to "bedrock" without a fully
# qualified model ID. Cross-region inference profile for Claude Sonnet 4.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# ─── Optional: OpenAI / Anthropic (direct, non-Bedrock) ───────
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- Support-escalation demo router (support_escalation_router.py) --------------------------
# Reuses OPENAI_API_KEY above (falls back to the deterministic offline gateway if unset).
# Optional: point at any OpenAI-compatible endpoint; defaults to https://api.openai.com/v1.
OPENAI_BASE_URL=

# --- LangSmith tracing (optional, app-level only — see dashboard/backend/tracing.py) --------
# Set LANGSMITH_API_KEY to enable; every agent's model call is logged as a LangSmith LLM run.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=korchestrator-fincrime-demo
LANGSMITH_TRACING=true
